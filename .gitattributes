# File chạy trên Linux phải giữ LF, kể cả khi clone trên Windows (core.autocrlf=true).
# CRLF làm bash báo "$'\r': command not found" và hỏng shebang.
*.sh       text eol=lf
*.sql      text eol=lf
*.conf     text eol=lf
*.example  text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.rules    text eol=lf
pg_hba.conf text eol=lf
